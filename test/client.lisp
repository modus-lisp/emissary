;;;; test/client.lisp -- an SBCL client: gift-wrapped requests to the agent.
;;;;   CLIENT_KEY (hex), STRANGER_KEY (hex), AGENT_PUB (hex), AGENT_RELAY
(load (merge-pathnames "deps.lisp" (make-pathname :name nil :type nil :defaults *load-truename*)))
(asdf:load-system "cl-nostr")
(defpackage :client (:use :cl))
(in-package :client)
(defvar *me* (uiop:getenv "CLIENT_KEY"))
(defvar *stranger* (uiop:getenv "STRANGER_KEY"))
(defvar *agent* (uiop:getenv "AGENT_PUB"))
(defvar *my-pub* (cl-nostr.keys:public-hex (cl-nostr.keys:keypair-from-secret *me*)))
(defvar *pool* (cl-nostr.pool:make-pool (list (uiop:getenv "AGENT_RELAY"))))
(defvar *replies* (make-hash-table :test 'equal))
(defvar *lock* (bt:make-lock))
(defvar *checks* 0) (defvar *fails* 0)
(defun chk (name ok) (incf *checks*) (format t "~&  ~a ~a~%" (if ok "ok  " "FAIL") name) (unless ok (incf *fails*)))
(cl-nostr.pool:pool-subscribe *pool*
  (list (cl-nostr.filter:make-filter :kinds '(1059) :tags (list (cons "p" (list *my-pub*)))
                                     :since (- (- (get-universal-time) 2208988800) 120)))
  :on-event (lambda (wrap relay) (declare (ignore relay))
              (multiple-value-bind (text sender) (cl-nostr.nip59:unwrap-giftwrap *me* wrap)
                (bt:with-lock-held (*lock*) (push (cons sender text) (gethash "all" *replies*))))))
(defun replies () (bt:with-lock-held (*lock*) (reverse (gethash "all" *replies*))))
(defun ask (key text) (cl-nostr.pool:pool-publish *pool* (cl-nostr.nip59:build-giftwrap key *agent* text)))
(defun await (n secs)
  (loop repeat (* secs 10) until (>= (length (replies)) n) do (sleep 0.1))
  (replies))

(defvar *t0* (get-internal-real-time))
(ask *me* "(+ 1 2)")
(let ((r (await 1 30))) (chk (format nil "(+ 1 2) -> 3: ~s" (cdr (first r))) (equal (cdr (first r)) "3")))
(chk "the reply comes from the agent's key" (equal (car (first (replies))) *agent*))
(ask *me* "(format t \"hello\") (values 1 :two \"three\")")
(let ((r (await 2 30))) (chk (format nil "values + output: ~s" (cdr (second r)))
                            (equal (cdr (second r)) (format nil "1~%:TWO~%\"three\"~%--- output:~%hello"))))
(ask *me* "(error \"boom ~a\" 42)")
(let ((r (await 3 30))) (chk (format nil "an error: ~s" (cdr (third r))) (equal (cdr (third r)) "error: boom 42")))
(ask *me* "(loop)")
(let ((r (await 4 30))) (chk (format nil "a runaway is stopped: ~s" (cdr (fourth r))) (search "timeout" (cdr (fourth r)))))
(ask *me* "(defvar *x* 41)")
(await 5 30)
(ask *me* "(boundp '*x*)")
(let ((r (await 6 30))) (chk (format nil "one request's state is not the next's: ~s" (cdr (sixth r))) (equal (cdr (sixth r)) "NIL")))
(ask *me* "#.(+ 1 2)")
(let ((r (await 7 30))) (chk (format nil "#. is refused (*read-eval* nil): ~s" (cdr (seventh r))) (search "error" (cdr (seventh r)))))
;; a key not on the allowlist gets nothing back
(ask *stranger* "(+ 40 2)")
(sleep 6)
(chk "a stranger gets no reply" (= (length (replies)) 7))
(format t "~&CLIENT: ~a checks, ~a failed  (~,1f s)~%" *checks* *fails*
        (/ (- (get-internal-real-time) *t0*) internal-time-units-per-second))
(cl-nostr.pool:close-pool *pool*)
(sb-ext:exit :code (if (zerop *fails*) 0 1) :abort t)
