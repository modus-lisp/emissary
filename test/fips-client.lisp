;;;; test/fips-client.lisp -- an SBCL cl-fips node: dial the agent over UDP and send
;;;; it forms as DataPackets.   CLIENT_KEY, STRANGER_KEY (hex), AGENT_NPUB, AGENT_ADDR
(load "/home/claude/peek-2026-10-13/modus-agent/test/deps.lisp")
(asdf:load-system "cl-fips/daemon")
(asdf:load-system "cl-nostr")
(defpackage :fclient (:use :cl))
(in-package :fclient)
(defvar *checks* 0) (defvar *fails* 0)
(defun chk (name ok) (incf *checks*) (format t "~&  ~a ~a~%" (if ok "ok  " "FAIL") name) (unless ok (incf *fails*)))
(defvar *agent* (uiop:getenv "AGENT_NPUB"))
(defun node (secret-hex)
  "A client node keyed by SECRET-HEX that dials the agent; replies collect in its cell."
  (let* ((replies (list nil))
         (d (cl-fips.daemon:make-daemon
             (list :udp (list :bind "127.0.0.1:0")
                   :peers (list (list :npub *agent* :transport :udp :addr (uiop:getenv "AGENT_ADDR"))))
             :keypair (secp256k1-fast.ecdh:keypair-from-secret (cl-nostr.util:hex->bytes secret-hex))
             :log (make-broadcast-stream)
             :on-event (lambda (d ev) (declare (ignore d))
                         (when (eq (first ev) :data)
                           (push (cl-nostr.util:utf8->string (fifth ev)) (car replies)))))))
    (cl-fips.daemon:daemon-start d)
    (cons d replies)))
(defun ask (n text) (cl-fips.daemon:daemon-send (car n) *agent* (cl-nostr.util:string->utf8 text)
                                                :src-port 5000 :dst-port 4601))
(defun await (n count secs)
  (loop with end = (+ (get-internal-real-time) (* secs internal-time-units-per-second))
        until (or (>= (length (cadr n)) count) (> (get-internal-real-time) end))
        do (cl-fips.daemon:daemon-step (car n) :max-wait-ms 50))
  (reverse (cadr n)))
(defvar *t0* (get-internal-real-time))
(defvar *me* (node (uiop:getenv "CLIENT_KEY")))
(ask *me* "(+ 1 2)")
(let ((r (await *me* 1 60))) (chk (format nil "(+ 1 2) over FIPS -> ~s" (first r)) (equal (first r) "3")))
(ask *me* "(format nil \"~a\" (expt 2 100))")
(let ((r (await *me* 2 30))) (chk (format nil "a bignum -> ~s" (second r)) (equal (second r) "\"1267650600228229401496703205376\"")))
(ask *me* "(make-string 5000 :initial-element #\\x)")
(let ((r (await *me* 3 30))) (chk (format nil "a long reply is cut to fit a packet (~d bytes)" (length (third r)))
                                  (and (third r) (<= (length (third r)) 1000))))
(defvar *stranger* (node (uiop:getenv "STRANGER_KEY")))
(ask *stranger* "(+ 40 2)")
(await *stranger* 1 25)
(chk "a stranger gets no reply" (null (cadr *stranger*)))
(format t "~&FIPS CLIENT: ~a checks, ~a failed  (~,1f s)~%" *checks* *fails*
        (/ (- (get-internal-real-time) *t0*) internal-time-units-per-second))
(sb-ext:exit :code (if (zerop *fails*) 0 1) :abort t)
