;;;; test/run-emissary.lisp -- run an emissary (modus or SBCL) until EMISSARY_STOP exists.
;;;;   EMISSARY_DIR, EMISSARY_RELAY, EMISSARY_STOP, MODUS_BIN, EMISSARY_TIMEOUT,
;;;;   EMISSARY_MARMOT (any value), EMISSARY_FIPS_UDP (host:port)
(load "/home/claude/peek-2026-10-13/emissary/test/deps.lisp")
(asdf:load-system "emissary")
(setf emissary:*eval-timeout* (parse-integer (or (uiop:getenv "EMISSARY_TIMEOUT") "10")))
(defvar *relay* (uiop:getenv "EMISSARY_RELAY"))
(defvar *e* (emissary:make-emissary :dir (uiop:getenv "EMISSARY_DIR") :relays (and *relay* (list *relay*))))
(emissary:ensure-core)
(emissary:emissary-start *e*)
(when (uiop:getenv "EMISSARY_MARMOT")
  (asdf:load-system "cl-marmot")
  (emissary:attach-marmot *e* (list *relay*) :interval 1))
(when (uiop:getenv "EMISSARY_FIPS_UDP")
  (asdf:load-system "cl-fips/daemon")
  (emissary:attach-fips *e* :udp (uiop:getenv "EMISSARY_FIPS_UDP")))
(with-open-file (o (concatenate 'string (uiop:getenv "EMISSARY_DIR") "ready")
                   :direction :output :if-exists :supersede)
  (write-line (emissary:emissary-npub *e*) o))
(defvar *stop* (uiop:getenv "EMISSARY_STOP"))
(emissary:emissary-run *e* :until (lambda () (probe-file *stop*)))
(emissary:emissary-stop *e*)
(format t "~&[emissary] stopped~%")
